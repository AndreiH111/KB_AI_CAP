{
  "name": "KB_AI_POC",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "2.8.0",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap/cds": "^10.0.3",
    "@sap/xssec": "^4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10.0.3",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "undeploy": "cf undeploy KB_AI_POC --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-kb_ai_poc_chatbot": "cds watch --open com.takeda.kbaipocchatbot/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      },
      "db": {
        "kind": "sqlite"
      },
      "KB_AI_CHATBOT": {
        "kind": "odata",
        "credentials": {
          "destination": "KB_AI_POC"
        }
      },
      "destinations": true,
      "html5-repo": true,
      "application-logging": true
    }
  },
  "workspaces": [
    "app/*"
  ]
}