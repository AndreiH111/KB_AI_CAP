<mvc:View controllerName="com.takeda.kbaipoc.controller.DataSource"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <f:DynamicPage id="dataSourceDynamicPageId">
        <f:title>
            <f:DynamicPageTitle id="dataSourcePageTitleId">
                <f:heading>
                    <Title id="dataSourceTitleId" text="{i18n>title}"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="dataSourceHeaderId" pinnable="true">
                <f:content>
                    <VBox id="dataSourceUploadWrapperId" width="auto">
                        <Label 
                            id="dataSourceUploadLabelId" 
                            text="{i18n>dataSource.uploadLabel}"/>

                        <HBox id="dataSourceUploadVBoxId" width="auto">
                            <u:FileUploader
                                id="fileUploader"
                                name="myFileUpload"
                                width="100%"
                                tooltip="{i18n>dataSource.uploadTooltip}"
                                sameFilenameAllowed="false"
                                class="sapUiSmallMarginEnd">
                                <u:layoutData>
                                    <FlexItemData id="fileUploaderFlexItemDataId" growFactor="1" maxWidth="40rem"/>
                                </u:layoutData>
                            </u:FileUploader>

                            <Button
                                id="uploadButtonId"
                                text="{i18n>dataSource.uploadButton}"
                                press=".handleUploadPress"
                                class="sapUiSmallMarginBegin"/>
                        </HBox>
                    </VBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox id="idDataSourceTableWrapper">
                <OverflowToolbar id="idDataSourceOverflowToolbar" style="Clear">
                    <Title id="idDataSourceTableTitle" text="{i18n>dataSource.tableTitle}" />
                    <ToolbarSpacer id="idToolbarSpacer"/>
                    <Button
                        id="idRefreshFilesBtn"
                        icon="sap-icon://refresh"
                        tooltip="{i18n>dataSource.table.refresh}"
                        press=".onRefreshFiles"/>
                    <Button
                        id="idDeleteFilesBtn"
                        text="{i18n>dataSource.table.deleteFiles}"
                        type="Emphasized"
                        enabled="false"
                        press=".onDeleteFiles"/>
                </OverflowToolbar>

                <Table
                    id="idDataSourceTable"
                    inset="false"
                    growing="true"
                    growingScrollToLoad="true"
                    growingThreshold="20"
                    mode="MultiSelect"
                    fixedLayout="true"
                    autoPopinMode="true"
                    selectionChange=".onSelectionChange"
                    sticky="ColumnHeaders"
                    updateFinished=".onUpdateFinished">
                    <columns>
                        <Column id="dataSourceColFileName" width="auto">
                            <header>
                                <Label id="dataSourceColFileNameLabel" text="{i18n>dataSource.table.fileName}" />
                            </header>
                        </Column>
                        <Column id="dataSourceColUploadDate" width="auto">
                            <header>
                                <Label id="dataSourceColUploadDateLabel" text="{i18n>dataSource.table.uploadedOn}" />
                            </header>
                        </Column>
                        <Column id="dataSourceColUploadedBy" width="auto">
                            <header>
                                <Label id="dataSourceColUploadedByLabel" text="{i18n>dataSource.table.uploadedBy}" />
                            </header>
                        </Column>
                        <Column id="dataSourceColStatus" width="auto">
                            <header>
                                <Label id="dataSourceColStatusLabel" text="{i18n>dataSource.table.status}" />
                            </header>
                        </Column>
                    </columns>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>

</mvc:View>